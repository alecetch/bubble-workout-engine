# Runtime
NODE_ENV=development
PORT=3000

# Local Postgres (docker-compose)
PGHOST=db
PGPORT=5432
PGUSER=app
PGPASSWORD=app
PGDATABASE=app
PGPOOL_MAX=10

# Deployed Postgres (Fly / managed)
# Prefer DATABASE_URL in staging/production
DATABASE_URL=

# App secrets
INTERNAL_API_TOKEN=change-me
JWT_SECRET=<min-32-char-random-string>
JWT_ISSUER=workout-engine
# Optional overrides (defaults shown):
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_DAYS=30

# Local MinIO (development)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/media-assets

# Deployed object storage (staging/production)
# S3_PUBLIC_BASE_URL=https://cdn.example.com/media-assets
# S3_BUCKET=media-assets
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# exercise-media is a separate Tigris project/bucket from the default one
# above, with its own dedicated credentials (Tigris scopes access keys
# per-project). Falls back to S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY above
# when unset - local dev's MinIO uses one shared credential for every bucket.
# S3_EXERCISE_MEDIA_ACCESS_KEY_ID=
# S3_EXERCISE_MEDIA_SECRET_ACCESS_KEY=

# Path to mobile coverage manifest (defaults to coverage-manifest.json in API working dir)
# COVERAGE_MANIFEST_PATH=

# Dev-to-production promotion (see docs/specs/exercise-media-production-promotion-spec.md).
# Never set these on production itself.
PROD_ADMIN_API_BASE_URL=
PROD_INTERNAL_API_TOKEN=

# HYROX calculator
HYROX_DATASET_PATH=
HYROX_EMAIL_FROM=
HYROX_RATE_LIMIT_PER_HOUR=10
FORMA_APP_BASE_URL=https://www.getforma.fit
APP_DOMAIN=https://www.getforma.fit
## Optional RevenueCat secret v1 API key. Entitlement sync returns 503 when unset.
REVENUECAT_SECRET_API_KEY=

# Website chrome and SEO brand; unset keeps Forma until trade mark clearance.
# BRAND_VARIANT=200days

# Effective date for 200 Days legal copy and rebrand changelog entry; set at cutover.
# LEGAL_UPDATED_DATE=15 May 2026

# Canonical website host; unset means no redirects.
# CANONICAL_HOST=200days.app
# Extra comma-separated hosts to redirect to CANONICAL_HOST.
# REDIRECT_HOSTS=
# Comma-separated SHA-256 release signing fingerprints, plus Play app-signing key if used.
# ANDROID_CERT_SHA256=
# Apple team ID and bundle ID used for Universal Links verification.
# APPLE_APP_ID=NNHW7677GQ.fit.get200days.app
# Android package used for App Links verification.
# ANDROID_PACKAGE_NAME=fit.get200days.app
