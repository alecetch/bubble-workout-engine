{
  "expo": {
    "name": "Forma",
    "slug": "bubble-workout-mobile",
    "version": "1.0.0",
    "scheme": "forma",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fit.getforma.app",
      "associatedDomains": [
        "applinks:getforma.fit"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "fit.getforma.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "getforma.fit",
              "pathPrefix": "/ref/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "@sentry/react-native/expo",
      "expo-video",
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0F172A"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "720b39f5-a083-4b4f-8546-bff9cd9ffe12"
      }
    },
    "owner": "alecetch",
    "icon": "./assets/icon.png"
  }
}
