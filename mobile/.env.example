# API base URL - points to the deployed Fly.io backend by default.
# For Android emulator local dev/E2E, use http://10.0.2.2:3000 instead of a LAN IP.
EXPO_PUBLIC_API_BASE_URL=https://bubble-workout-api.fly.dev

# Sentry DSN for crash/error reporting. Leave unset to disable reporting (dev default).
EXPO_PUBLIC_SENTRY_DSN=

# Full-bleed hero image behind the Welcome screen (pre-auth). Leave unset
# to use the flat background; no image is required for the app to run.
EXPO_PUBLIC_WELCOME_HERO_URL=
